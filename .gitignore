# 依赖：体积过大，可由 pnpm-lock.yaml 重建
node_modules
/.pnpm-store/
.codegraph/
*.tgz

# 注意：不忽略 docs/ —— docs/ZCODE-DESIGN.md 与 UPSTREAM-CHANGELOG 是设计溯源文档，
# 必须纳入版本控制（上游 dsh-codex-ui 曾把 docs/ 当产物忽略，本 fork 已修正）。
#
# 也不忽略 lib/ —— 本插件以 link: 协议安装进 DSH profile，宿主实际加载的是
# lib/index.mjs 与 lib/client.js；纳入 lib/ 才能保证回滚后立即可用，无需重新构建。

# 本地开发脚手架：调试补丁、截图脚本与截图产物。
# 调试补丁内含各人机器上的绝对路径，截图产物会带上本机真实的工作区与账户信息，
# 因此一律不入库。
debug/

# 真实会话回放数据（2026-10-18）：由 scripts/extract-session-replay.py 从本机会话导出，
# 1.7MB，内容含真实对话正文与本机绝对路径。它是性能脚本的输入素材，不是仓库资产，
# 任何脚本都不应硬依赖它（现在也确实没有引用）。重新生成方式见那个 .py 的注释。
scripts/fixtures/real-session-messages.json

# 本地备份（改动前快照，不入库）
*.bak-*
*.bak
*.bak2-*

# tsdown 构建中间产物：sync-dist 只负责把它拷进 lib/（见 scripts/sync-dist.mjs），
# 宿主加载与回滚用的都是 lib/，dist/ 随时可由 npm run build 重建，不入库。
dist/
